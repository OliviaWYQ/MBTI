  "order": ["IE", "ND", "MF", "RP"],
  "definitions": {
    "IE": {
      "name": "陪伴方式",
      "model": "陪伴模型",
      "levels": {
        "L": "陪伴只要在场就好：互不打扰，贴贴式亲密刚刚好。",
        "M": "看状态切换：有时想安静贴着，有时想拿来玩两下。",
        "H": "陪伴要互动：你来我往、有来有回才尽兴。"
      }
    },
    "ND": {
      "name": "作息",
      "model": "作息模型",
      "levels": {
        "L": "白天是主战场，到点睡觉，第二天还要当人。",
        "M": "能早能晚，最终解释权归 deadline 所有。",
        "H": "深夜才是自己：凌晨两点，灵感全开。"
      }
    },
    "MF": {
      "name": "二创欲",
      "model": "二创模型",
      "levels": {
        "L": "现成的好东西直接享受——拆它干嘛，拆了不保修吧。",
        "M": "看东西下菜：大部分时候享受，心痒了也动手。",
        "H": "不折腾难受：万物皆可改，螺丝刀是佩剑。"
      }
    },
    "RP": {
      "name": "贫富",
      "model": "贫富模型",
      "levels": {
        "L": "每一分钱都要花出战术价值，预算就是底线。",
        "M": "大钱看热爱，小钱看心情，比例随缘。",
        "H": "为热爱买单眼都不眨：千金难买我乐意。"
      }
    }
  }
}
