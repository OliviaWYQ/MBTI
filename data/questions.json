      "text": "你在家最常窝在哪？",
      "options": [
        { "label": "书桌", "value": 1 },
        { "label": "床", "value": 2 },
        { "label": "沙发", "value": 3 },
        { "label": "地上（和宠物一起）", "value": 4 },
        { "label": "飘窗或地毯", "value": 5 }
